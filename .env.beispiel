# Vorlage. Kopieren nach .env und ausfuellen:
#     cp .env.beispiel .env
#
# .env steht in .gitignore und gehoert NIE ins Repository.
#
# Eine gesetzte Umgebungsvariable UI_API_KEY sticht diese Datei - so laeuft
# ein Lauf mit einem anderen Schluessel, ohne die Datei anzufassen.
#
# Woher der Schluessel kommt: UniFi Site Manager, Profil -> API-Schluessel.
# Lesender Zugriff genuegt.
UI_API_KEY=hier-den-schluessel-eintragen
